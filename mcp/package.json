{
  "name": "bg-remove-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Local stdio MCP server that removes image backgrounds with the same RMBG-1.4 pipeline as the bg-remove web app.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "bg-remove-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 test/pipeline.test.mjs test/mcp.test.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@huggingface/transformers": {
      "sharp": "$sharp"
    }
  }
}
